#!/usr/bin/env python3
"""Dry-run-first installer for an efficient, agent-neutral development host."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from dataclasses import dataclass
from typing import Iterable


@dataclass(frozen=True, slots=True)
class Component:
    commands: tuple[str, ...]
    packages: dict[str, str]
    description: str
    pipx_package: str | None = None
    manual_url: str | None = None


COMPONENTS = {
    "git": Component(("git",), {"apt": "git", "dnf": "git", "pacman": "git", "brew": "git"}, "version control"),
    "curl": Component(("curl",), {"apt": "curl", "dnf": "curl", "pacman": "curl", "brew": "curl"}, "HTTP diagnostics"),
    "ripgrep": Component(("rg",), {"apt": "ripgrep", "dnf": "ripgrep", "pacman": "ripgrep", "brew": "ripgrep"}, "fast recursive search"),
    "jq": Component(("jq",), {"apt": "jq", "dnf": "jq", "pacman": "jq", "brew": "jq"}, "structured JSON inspection"),
    "fd": Component(("fd", "fdfind"), {"apt": "fd-find", "dnf": "fd-find", "pacman": "fd", "brew": "fd"}, "fast file discovery"),
    "fzf": Component(("fzf",), {"apt": "fzf", "dnf": "fzf", "pacman": "fzf", "brew": "fzf"}, "interactive filtering"),
    "tmux": Component(("tmux",), {"apt": "tmux", "dnf": "tmux", "pacman": "tmux", "brew": "tmux"}, "resilient terminal sessions"),
    "direnv": Component(("direnv",), {"apt": "direnv", "dnf": "direnv", "pacman": "direnv", "brew": "direnv"}, "scoped project environments"),
    "shellcheck": Component(("shellcheck",), {"apt": "shellcheck", "dnf": "ShellCheck", "pacman": "shellcheck", "brew": "shellcheck"}, "shell static analysis"),
    "python": Component(("python3",), {"apt": "python3", "dnf": "python3", "pacman": "python", "brew": "python"}, "Python runtime"),
    "pipx": Component(("pipx",), {"apt": "pipx", "dnf": "pipx", "pacman": "python-pipx", "brew": "pipx"}, "isolated Python CLI installs"),
    "uv": Component(("uv",), {}, "fast Python environment and package workflow", pipx_package="uv"),
    "ruff": Component(("ruff",), {}, "fast Python linting and formatting", pipx_package="ruff"),
    "pre-commit": Component(("pre-commit",), {}, "repeatable repository checks", pipx_package="pre-commit"),
    "psql": Component(("psql",), {"apt": "postgresql-client", "dnf": "postgresql", "pacman": "postgresql", "brew": "libpq"}, "PostgreSQL client"),
    "redis-cli": Component(("redis-cli",), {"apt": "redis-tools", "dnf": "redis", "pacman": "redis", "brew": "redis"}, "Redis client"),
    "sqlite": Component(("sqlite3",), {"apt": "sqlite3", "dnf": "sqlite", "pacman": "sqlite", "brew": "sqlite"}, "local structured scratch data"),
    "docker": Component(
        ("docker",), {}, "containerized local services", manual_url="https://docs.docker.com/engine/install/",
    ),
}

GROUPS = {
    "core": ("git", "curl", "ripgrep", "jq", "fd", "fzf", "tmux", "direnv", "shellcheck"),
    "python": ("python", "pipx", "uv"),
    "quality": ("ruff", "pre-commit"),
    "services": ("docker", "psql", "redis-cli", "sqlite"),
}

MANAGER_BINARIES = {"apt": "apt-get", "dnf": "dnf", "pacman": "pacman", "brew": "brew"}


def detect_manager(requested: str) -> str | None:
    if requested != "auto":
        return requested
    for manager, command in MANAGER_BINARIES.items():
        if shutil.which(command):
            return manager
    return None


def selected_components(groups: Iterable[str]) -> list[str]:
    return list(dict.fromkeys(component for group in groups for component in GROUPS[group]))


def component_present(component: Component) -> tuple[bool, str | None]:
    for command in component.commands:
        resolved = shutil.which(command)
        if resolved:
            return True, resolved
    return False, None


def plan(groups: list[str], manager: str | None) -> list[dict[str, str]]:
    actions: list[dict[str, str]] = []
    for name in selected_components(groups):
        component = COMPONENTS[name]
        present, path = component_present(component)
        if present:
            actions.append({
                "component": name, "status": "present", "via": "path",
                "target": path or "", "description": component.description,
            })
        elif component.pipx_package:
            actions.append({
                "component": name, "status": "would-install", "via": "pipx",
                "target": component.pipx_package, "description": component.description,
            })
        elif manager and manager in component.packages:
            actions.append({
                "component": name, "status": "would-install", "via": manager,
                "target": component.packages[manager], "description": component.description,
            })
        else:
            actions.append({
                "component": name, "status": "manual", "via": "official-docs",
                "target": component.manual_url or "no supported installer for this host",
                "description": component.description,
            })
    return actions


def privilege_prefix(manager: str) -> list[str]:
    if manager == "brew" or (hasattr(os, "geteuid") and os.geteuid() == 0):
        return []
    sudo = shutil.which("sudo")
    if not sudo:
        raise RuntimeError(f"{manager} installation requires root or sudo")
    return [sudo]


def run_checked(command: list[str]) -> None:
    subprocess.run(command, check=True)


def install_system_packages(manager: str, packages: list[str], assume_yes: bool) -> None:
    packages = list(dict.fromkeys(packages))
    if not packages:
        return
    executable = shutil.which(MANAGER_BINARIES[manager])
    if not executable:
        raise RuntimeError(f"selected package manager is unavailable: {manager}")
    prefix = privilege_prefix(manager)
    if manager == "apt":
        run_checked([*prefix, executable, "update"])
        run_checked([*prefix, executable, "install", *(["-y"] if assume_yes else []), *packages])
    elif manager == "dnf":
        run_checked([*prefix, executable, "install", *(["-y"] if assume_yes else []), *packages])
    elif manager == "pacman":
        run_checked([*prefix, executable, "-S", "--needed", *(["--noconfirm"] if assume_yes else []), *packages])
    elif manager == "brew":
        run_checked([executable, "install", *packages])


def pipx_command() -> list[str]:
    executable = shutil.which("pipx")
    if executable:
        return [executable]
    python = shutil.which("python3")
    if python:
        probe = subprocess.run([python, "-m", "pipx", "--version"], capture_output=True)
        if probe.returncode == 0:
            return [python, "-m", "pipx"]
    raise RuntimeError("pipx is unavailable after system package installation")


def apply_plan(actions: list[dict[str, str]], manager: str | None, assume_yes: bool) -> None:
    system_actions = [
        action for action in actions
        if action["status"] == "would-install" and action["via"] in MANAGER_BINARIES
    ]
    if system_actions:
        if manager is None:
            raise RuntimeError("no supported package manager was detected")
        install_system_packages(manager, [action["target"] for action in system_actions], assume_yes)
        for action in system_actions:
            action["status"] = "installed"

    pipx_actions = [
        action for action in actions
        if action["status"] == "would-install" and action["via"] == "pipx"
    ]
    if pipx_actions:
        command = pipx_command()
        for action in pipx_actions:
            if component_present(COMPONENTS[action["component"]])[0]:
                action["status"] = "present"
                continue
            run_checked([*command, "install", action["target"]])
            action["status"] = "installed"


def print_human(mode: str, manager: str | None, groups: list[str], actions: list[dict[str, str]]) -> None:
    print(f"mode={mode} manager={manager or 'none'} groups={','.join(groups)}")
    for action in actions:
        print(
            f"{action['status']:<13} {action['component']:<12} "
            f"via={action['via']:<13} target={action['target']}"
        )
    if mode == "dry-run":
        print("No changes made. Re-run with --apply after reviewing this plan.")


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Install a small, agent-neutral host toolset; dry-run is the default",
    )
    parser.add_argument("--group", action="append", choices=tuple(GROUPS), dest="groups")
    parser.add_argument("--manager", choices=("auto", *MANAGER_BINARIES), default="auto")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--apply", action="store_true")
    mode.add_argument("--dry-run", action="store_true")
    parser.add_argument("--yes", action="store_true", help="pass non-interactive confirmation to the package manager")
    parser.add_argument("--json", action="store_true", dest="as_json")
    parser.add_argument("--list-groups", action="store_true")
    args = parser.parse_args()

    if args.list_groups:
        for group, components in GROUPS.items():
            print(f"{group}: {', '.join(components)}")
        return 0

    groups = args.groups or ["core", "python", "quality"]
    manager = detect_manager(args.manager)
    actions = plan(groups, manager)
    mode_name = "apply" if args.apply else "dry-run"
    if args.apply:
        try:
            apply_plan(actions, manager, args.yes)
        except (RuntimeError, subprocess.CalledProcessError) as exc:
            print(f"agent-host-bootstrap: {exc}", file=sys.stderr)
            return 1

    payload = {"mode": mode_name, "manager": manager, "groups": groups, "actions": actions}
    if args.as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print_human(mode_name, manager, groups, actions)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
